---
// Figma：Group 23（頁首）＋ 跑嗎燈燈（跑馬燈，每 5 秒換一句）＋ 目錄封面（三槓打開的選單）
import { Image, getImage } from 'astro:assets';
import headerTop from '../assets/header-top.png';
import headerTopDesktop from '../assets/header-top-desktop.png';
import logo from '../assets/logo.png';
import logoWhite from '../assets/logo-white.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname;
// 「網站放的圖片／首頁頁首-電腦板」只裁出上面的花紋那段（下面米白那段就是導覽列底色）；使用者要求不壓縮，維持 PNG 無損
const desktopBand = await getImage({ src: headerTopDesktop, format: 'png' });
// 手機往上延伸進瀏海的那段花紋（見下面頁首的說明）
const notchBand = await getImage({ src: headerTop, width: 786 });

const messages = [
	'【Welcome】歡迎來到島郵！今天想寄出什麼樣的心情呢 ⋆⸜',
	'【島郵廣播】生活需要一點儀式感，用文字紀錄今天的特別吧！',
	'天氣真好，最適合寫一封信給重要的人了°⋰˚', // 設計稿結尾的「୭̥」多數手機沒有字型，會顯示成方框
	'初次見面，慢慢逛、慢慢看，挑一張喜歡的明信片吧！',
	'你知道嗎？台灣的綠色郵筒寄平信，紅色則是寄限時與航空信件喔！',
	'臺灣最深的郵筒在綠島海底，要潛水才能寄信呢 🤿',
	'台灣有一對被颱風吹歪的「歪腰郵筒」，充滿了可愛的生命力！',
	'為什麼許多國家的郵筒是紅色的？因為紅色最醒目，遠遠就能看見它 📮',
	'全台海拔最高的郵筒在阿里山上，是一座離天空最近的郵筒 ☁️',
	'「郵票」就像是信件的專屬車票，貼上它就能展開一場漫長的旅行囉 🚂',
];

const menu = [
	{ name: '特色郵筒', href: `${base}/map/` },
	{ name: '郵政知識', href: `${base}/knowledge/` },
	{ name: '在地風味', href: `${base}/local/` },
	{ name: '島郵周邊', href: `${base}/shop/` },
	{ name: '關於島郵', href: `${base}/about/` },
	// 設計稿沒有個人檔案的入口，使用者決定加在選單最後；沒登入會先導到登入頁
	{ name: '個人檔案', href: `${base}/profile/` },
];
---

<!-- 使用者要求：電腦版滑動時整個頁首固定在最上面（高 87＋60＝147px）；
     手機、平板（2026-11-03）：頁首完全不動：瀏海裡是花紋（#notch-fill），下面露出 28px 花紋（跑馬燈），再下面是導覽列。
     （等於原本 87px 的花紋上面 59px 藏在瀏海後面，Dynamic Island 機型瀏海高 59px。）
     頁面最外層不捲動，改由頁首下面的內容區（Layout 的 #scroller）自己捲，所以頁首、花紋不用 sticky 就固定在上面。
     瀏海：iOS 26 Safari 頂端碰到 sticky／fixed 元素時會拿它的底色塗滿瀏海（之前的白條），而且固定的東西畫不進瀏海；
     內容區自己捲也不會捲進瀏海。花紋不墊底色、pointer-events-none（裡面沒有可點的東西），讓 Safari 跳過它不塗色，
     瀏海就照實畫出 #notch-fill。電腦版維持整個頁首 sticky、頁面本身捲動。header 用 contents 讓花紋、導覽列各自排。 -->
<header class="contents">
	<!-- 電腦版花紋圖是半透明的，墊白底：頁首固定後下面捲上來的內容才不會透出來；手機版的圖不透明 -->
	<div class="pointer-events-none relative z-40 h-[28px] lg:pointer-events-auto lg:sticky lg:top-0 lg:h-[87px] lg:bg-white">
		<picture>
			<source media="(min-width: 1024px)" srcset={desktopBand.src} />
			<Image src={headerTop} alt="" class="absolute inset-0 size-full object-cover object-bottom lg:object-top" loading="eager" />
		</picture>
		<p
			id="ticker"
			class="absolute inset-x-0 top-0 truncate lg:top-[59px] px-8 text-center text-2xs text-white transition-opacity duration-500"
			aria-live="off"
		>
			{messages[0]}
		</p>
	</div>
	<!-- 瀏海後面的花紋：頁面頂端往上 320px（畫面外，只有瀏海看得到），花紋接縫對齊下面的 28px 花紋 -->
	<div
		id="notch-fill"
		class="pointer-events-none absolute inset-x-0 -top-[320px] h-[320px] lg:hidden"
		style={`background: url(${notchBand.src}) center top / 100% auto repeat-y`}
		aria-hidden="true"
	>
	</div>
	<nav class="relative z-40 bg-header-bar lg:sticky lg:top-[87px]" aria-label="主選單">
		<div class="mx-auto flex h-[60px] max-w-6xl items-center px-5 lg:px-8">
			<a href={`${base}/`} class="mr-auto"><Image src={logo} alt="島郵 Isle Post 首頁" width={48} densities={[1, 2, 3]} loading="eager" /></a>
			<!-- 電腦版：選單直接攤開在頁首 -->
			<ul class="hidden gap-8 font-round text-md text-pink lg:flex">
				{
					menu.map((m) => (
						<li><a href={m.href} aria-current={here.startsWith(m.href) ? 'page' : undefined} class="hover:underline aria-[current]:font-bold aria-[current]:underline">{m.name}</a></li>
					))
				}
			</ul>
			<button popovertarget="site-menu" class="p-2 text-header-pink lg:hidden" aria-label="開啟選單">
				<svg class="burger" width="20" height="18" viewBox="0 0 20 18" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<line x1="0" y1="1" x2="20" y2="1" /><line x1="0" y1="9" x2="20" y2="9" /><line x1="0" y1="17" x2="20" y2="17" />
				</svg>
			</button>
		</div>
	</nav>

	<div
		id="site-menu"
		popover
		class="fixed inset-auto top-[146px] right-0 m-0 w-[184px] bg-header-pink p-0 pb-5 text-white shadow-soft md:right-[max(0px,calc((100vw-72rem)/2))]"
	>
		<div class="flex items-start justify-between px-2.5 pt-4">
			<a href={`${base}/`}><Image src={logoWhite} alt="島郵 Isle Post 首頁" width={48} densities={[1, 2, 3]} /></a>
			<button popovertarget="site-menu" popovertargetaction="hide" class="mr-6 p-1" aria-label="關閉選單">
				<svg width="20" height="20" viewBox="0 0 20 20" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M0 0l20 20M20 0L0 20" />
				</svg>
			</button>
		</div>
		<ul class="mt-5 flex flex-col gap-3.5 px-2.5 font-round text-sm">
			{
				menu.map((m, i) => (
					<li style={`--i:${i}`}><a href={m.href} aria-current={here.startsWith(m.href) ? 'page' : undefined} class="aria-[current]:font-bold">{m.name}</a></li>
				))
			}
		</ul>
		<svg class="mt-3.5 ml-[23px]" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f2ede6" stroke-width="2" aria-label="Instagram">
			<rect x="1" y="1" width="22" height="22" rx="6" /><circle cx="12" cy="12" r="4.9" /><circle cx="17.5" cy="6" r="1" fill="#f2ede6" />
		</svg>
	</div>
</header>

<script is:inline define:vars={{ messages }}>
	// 原型：滑鼠移出選單就關閉（MOUSE_LEAVE → CLOSE）；手機點選單外面關閉
	const menu = document.getElementById('site-menu');
	// 花紋捲走後導覽列會往上移，選單打開時貼齊導覽列底部
	const nav = menu.previousElementSibling;
	const place = () => (menu.style.top = `${nav.getBoundingClientRect().bottom - 1}px`);
	menu.addEventListener('beforetoggle', place);
	menu.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && menu.hidePopover());

	// iOS 16 以下沒有 popover：選單會一直在（只是透明）擋住點擊。改成自己切換 hidden，不做動畫
	if (!('popover' in HTMLElement.prototype)) {
		Object.assign(menu, { hidden: true, hidePopover: () => (menu.hidden = true) });
		Object.assign(menu.style, { opacity: '1', transform: 'none' });
		document.addEventListener('click', (e) => {
			const b = e.target.closest('[popovertarget="site-menu"]');
			if (b) {
				menu.hidden = b.getAttribute('popovertargetaction') === 'hide' || !menu.hidden;
				if (!menu.hidden) place();
			} else if (!menu.contains(e.target)) menu.hidden = true;
		});
	}

	const el = document.getElementById('ticker');
	let i = 0;
	setInterval(() => {
		el.style.opacity = '0';
		setTimeout(() => {
			el.textContent = messages[(i = (i + 1) % messages.length)];
			el.style.opacity = '1';
		}, 500);
	}, 5000);
</script>
