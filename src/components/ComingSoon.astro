---
// 設計稿還沒畫好的頁面（島郵周邊、關於島郵）：先放關於島郵的信封圖＋「即將開放」
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import envelope from '../assets/envelope.png';

interface Props {
	title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={title}>
	<main class="flex flex-1 flex-col items-center px-6 pt-12 pb-16 text-center">
		<Image src={envelope} alt="" widths={[400, 600]} sizes="400px" class="h-auto w-full max-w-[400px]" />
		<h1 class="mt-4 text-3xl font-bold text-pink">{title}</h1>
		<p class="mt-2 text-md text-muted">即將開放，敬請期待！</p>
		<a href={`${base}/map/`} class="press mt-8 inline-grid h-10 w-40 place-items-center rounded-full bg-butter text-lg font-bold text-pink">先去逛特色郵筒</a>
	</main>
</Layout>
