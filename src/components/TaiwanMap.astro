---
// Figma：特色郵筒的 台灣分開_*（每個縣市一張圖）＋黃色縣市標籤。
// 地圖改用政府開放資料畫成 SVG，資料來源見 scripts/gen-taiwan-map.mjs。
// 座標是設計稿 frame 扣掉頁首（147px）後的位置。
// 點縣市時，被點的標籤會「長成」縣市頁的大標（設計稿 台中→台中 #2 的過場）。
// 轉場名稱只在換頁那一刻加在被點的那一個標籤上（pageswap／pagereveal），不常駐在 17 個標籤上
import map from '../data/taiwan-map.json';
import { counties, isLocked, mailboxes } from '../data/mailboxes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullName = Object.fromEntries(counties.map((c) => [c.slug, c.fullName]));
const hasMailbox = new Set(mailboxes.map((m) => m.county));
// 有特色郵筒的縣市標籤右上角加粉紅小點（設計稿沒有，讓人知道哪裡點進去有內容）；未開放縣市只有完整權限看得到（data-locked）

// [slug, x, y]；花東、宜蘭是直式標籤
const labels: [string, number, number][] = [
	['taipei', 216, 74], ['new-taipei', 151, 115], ['keelung', 108, 156.5], ['taoyuan', 86, 198],
	['hsinchu', 60, 239], ['miaoli', 38, 280], ['taichung', 24, 321.5], ['changhua', 11, 363],
	['nantou', 9, 404], ['yunlin', 5, 445], ['chiayi', 23, 486.5], ['tainan', 40, 528],
	['kaohsiung', 87, 569], ['pingtung', 108, 618],
];
const vertical: [string, number, number][] = [['yilan', 352, 183], ['hualien', 319, 311], ['taitung', 263, 476]];
---

<svg viewBox={map.viewBox} preserveAspectRatio="none" class="absolute top-[111px] left-[94px] h-[510px] w-[259px]" aria-hidden="true">
	<defs>
		<pattern id="dots" width="5" height="5" patternUnits="userSpaceOnUse">
			<circle cx="2.5" cy="2.5" r="0.9" class="fill-map-line/40" />
		</pattern>
		<pattern id="dots-on" width="5" height="5" patternUnits="userSpaceOnUse">
			<rect width="5" height="5" class="fill-butter" /><circle cx="2.5" cy="2.5" r="0.9" class="fill-map-line/40" />
		</pattern>
	</defs>
	{
		counties.map((c) => (
			<a href={`${base}/map/${c.slug}/`} tabindex="-1" class="county" data-slug={c.slug}>
				<path d={map.paths[c.slug as keyof typeof map.paths]} />
			</a>
		))
	}
</svg>

<nav aria-label="選擇縣市">
	{
		labels.map(([slug, x, y]) => (
			<a href={`${base}/map/${slug}/`} data-slug={slug} class:list={['label absolute grid h-[26px] w-[70px] place-items-center rounded-full bg-butter text-md font-extrabold text-pink']} style={`left:${x}px;top:${y}px`}>
				{fullName[slug]}
				{hasMailbox.has(slug) && (
					<span class="contents" data-locked={isLocked(slug) || undefined}>
						<span class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full border-2 border-white bg-pink" aria-hidden="true" />
						<span class="sr-only">（有特色郵筒）</span>
					</span>
				)}
			</a>
		))
	}
	{
		vertical.map(([slug, x, y]) => (
			<a href={`${base}/map/${slug}/`} data-slug={slug} class:list={['label absolute grid h-[70px] w-[30px] place-items-center rounded-full bg-butter text-md leading-none font-extrabold text-pink [writing-mode:vertical-rl]']} style={`left:${x}px;top:${y}px`}>
				{fullName[slug]}
				{hasMailbox.has(slug) && (
					<span class="contents" data-locked={isLocked(slug) || undefined}>
						<span class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full border-2 border-white bg-pink" aria-hidden="true" />
						<span class="sr-only">（有特色郵筒）</span>
					</span>
				)}
			</a>
		))
	}
</nav>

<style>
	.county path {
		fill: url(#dots);
		stroke: var(--color-map-line);
		stroke-width: 3;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
		transition: fill 0.2s;
	}
	.county:hover path,
	.county.on path {
		fill: url(#dots-on);
	}
</style>

<script>
	// 離開地圖去縣市頁：被點的標籤取名 county-title，跟縣市頁 h1 同名就會補間
	const labelFor = (url?: string | null) => {
		const slug = url && new URL(url).pathname.match(/\/map\/([^/]+)\/$/)?.[1];
		return slug ? document.querySelector<HTMLElement>(`.label[data-slug="${slug}"]`) : null;
	};
	const name = (el: HTMLElement | null, t?: ViewTransition) => {
		if (!el || !t) return;
		el.style.viewTransitionName = 'county-title';
		t.finished.finally(() => (el.style.viewTransitionName = ''));
	};
	addEventListener('pageswap', (e: any) => name(labelFor(e.activation?.entry?.url), e.viewTransition));
	// 從縣市頁回到地圖：大標縮回標籤
	addEventListener('pagereveal', (e: any) => name(labelFor((navigation as any)?.activation?.from?.url), e.viewTransition));

	// 滑到標籤時，地圖上的縣市一起亮起來
	document.querySelectorAll<HTMLElement>('.label').forEach((label) => {
		const county = document.querySelector(`.county[data-slug="${label.dataset.slug}"]`)!;
		const on = (v: boolean) => () => county.classList.toggle('on', v);
		label.addEventListener('pointerenter', on(true));
		label.addEventListener('pointerleave', on(false));
		label.addEventListener('focus', on(true));
		label.addEventListener('blur', on(false));
	});
</script>
