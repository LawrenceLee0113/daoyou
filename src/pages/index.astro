---
// Figma：封面
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import cover from '../assets/cover.jpg';
import newsTitle from '../assets/news-title.png';
import texture from '../assets/header-top.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 活動照片：使用者提供的「網站放的圖片／封面-2～6」，縮到 1200px 寬
const newsPhotos = Object.values(import.meta.glob<{ default: ImageMetadata }>('../assets/news/*.jpg', { eager: true })).map((m) => m.default);
const post = `回顧 08/14-08/15｜在戀曲盛典，讓故事透過《島郵》持續流動

這兩天，我們帶著《島郵》計畫與「迴郵明信片交換」來到了戀曲盛典！
「寫下一段給陌生人的祝福，就能帶走另一位旅人的故事。」

這兩天最深刻的畫面，是看到好多人在攤位前靜下心來，握著筆認真思考、一字一句寫下對遠方陌生人的溫暖鼓勵，再親手將明信片投進我們準備的特色郵筒裡。那一刻，市集的喧囂彷彿慢了下來，只剩下手寫的專注與期待。

好多朋友蓋下專屬紀念郵戳、換到上一位陌生人留下的溫暖文字時，臉上露出的驚喜與感動，真的給了我們好大好大的力量！這證明了：在這個訊息秒發秒收的時代，大家依然深深渴望著手寫的溫度與「等待」的浪漫。

謝謝每一個在戀曲盛典駐足、寫下故事、參與島郵的你。

因為有你們的加入，讓這些明信片有了生命，也讓這趟島嶼尋郵之旅變得更加溫暖美好！

我們下個據點見，繼續把愛與故事寄向遠方。`;
---

<Layout>
	<!-- 電腦版：左邊主視覺、右邊最新消息 -->
	<main class="flex-1 lg:mx-auto lg:grid lg:w-full lg:max-w-6xl lg:grid-cols-[minmax(0,460px)_1fr] lg:items-start lg:gap-14 lg:px-8 lg:py-12">
		<h1 class="sr-only">島郵 Isle Post：寄存島嶼的地方郵誌</h1>
		<a href={`${base}/map/`} class="block md:mx-auto md:max-w-[460px] lg:sticky lg:top-8 lg:overflow-hidden lg:rounded-3xl">
			<Image src={cover} alt="島郵 Isle Post：寄存島嶼的地方郵誌，前往特色郵筒地圖" widths={[393, 788]} sizes="(min-width: 460px) 460px, 100vw" class="w-full" loading="eager" />
		</a>

		<section class="pt-[37px] lg:min-w-0 lg:pt-2" aria-labelledby="news">
			<h2 id="news" class="px-[22px] md:mx-auto md:max-w-2xl md:px-8 lg:px-0"><Image src={newsTitle} alt="NEWS 最新消息" width={93} height={16} class="lg:w-[140px]" /></h2>
			<!-- 手機：左右滑；平板以上：排成兩大三小的照片格 -->
			<div class="mt-[19px] flex snap-x snap-mandatory gap-[26px] overflow-x-auto px-[calc((100%-300px)/2)] [scrollbar-width:none] md:mx-auto md:grid md:max-w-2xl md:grid-cols-6 md:gap-3 md:overflow-visible md:px-8 lg:px-0">
				{
					newsPhotos.map((src, i) => (
						<Image
							src={src}
							alt={`戀曲盛典活動照片 ${i + 1}`}
							widths={[300, 600]}
							sizes="(min-width: 768px) 330px, 300px"
							class:list={['h-[200px] w-[300px] shrink-0 snap-center rounded-news object-cover md:aspect-[3/2] md:h-auto md:w-full', i < 2 ? 'md:col-span-3' : 'md:col-span-2']}
						/>
					))
				}
			</div>
			<p class="mx-auto mt-[18px] w-[300px] max-w-[calc(100%-84px)] text-sm whitespace-pre-line md:w-full md:max-w-2xl md:px-8 md:text-base md:leading-relaxed lg:px-0">{post}</p>
		</section>
	</main>

	<footer class="relative isolate mt-10 flex h-[89px] flex-col items-center justify-center text-white">
		<Image src={texture} alt="" class="absolute inset-0 -z-10 size-full object-cover" />
		<h2 class="font-sung text-lg font-bold">聯繫方式</h2>
		<p class="mt-1 font-hei text-2xs font-medium">活動信箱 : <a href="mailto:repost116.grad@gmail.com">repost116.grad@gmail.com</a></p>
	</footer>
</Layout>
