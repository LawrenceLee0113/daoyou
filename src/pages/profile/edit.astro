---
// Figma：個人檔案-編輯。資料只存在這支手機上
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import { counties } from '../../data/mailboxes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const label = 'mt-3.5 block text-sm font-bold text-muted';
const box = 'mt-1.5 block w-full rounded-[10px] border border-input bg-white px-3.5 text-lg outline-none focus:border-pink';
---

<Layout title="編輯個人檔案">
	<Panel class="pt-[34px] pb-6 md:max-w-xl">
		<form id="edit" novalidate>
			<div class="flex items-center justify-between">
				<a href={`${base}/profile/`} onclick="event.preventDefault(); location.replace(this.href)" class="text-md font-bold text-olive">取消</a>
				<h1 class="text-lg font-bold">編輯個人檔案</h1>
				<button class="text-md font-bold text-pink">儲存</button>
			</div>

			<label class="mx-auto mt-4 flex w-fit cursor-pointer flex-col items-center">
				<span class="relative">
					<span id="avatar" class="grid size-[72px] place-items-center overflow-hidden rounded-full bg-butter/70 text-avatar font-bold text-pink">旅</span>
					<span class="absolute -right-0.5 -bottom-1 grid size-[26px] place-items-center rounded-full bg-pink text-sm" aria-hidden="true">📷</span>
				</span>
				<span class="mt-2 text-sm font-bold text-pink">更換頭像</span>
				<input id="avatar-file" type="file" accept="image/*" class="sr-only" />
			</label>

			<label class={label}>
				暱稱
				<span class="relative block">
					<input name="nickname" maxlength="12" required class:list={[box, 'h-11 pr-14 text-ink']} />
					<span data-count="nickname" class="absolute top-1/2 right-3.5 -translate-y-1/2 text-xs font-normal text-muted"></span>
				</span>
			</label>

			<label class={label}>
				自我介紹
				<span class="relative block">
					<textarea name="bio" maxlength="60" rows="3" class:list={[box, 'resize-none py-3 pb-6 text-base leading-relaxed text-ink']}></textarea>
					<span data-count="bio" class="absolute right-3.5 bottom-2.5 text-xs font-normal text-muted"></span>
				</span>
			</label>

			<label class={label}>
				常駐縣市
				<select name="county" class:list={[box, 'h-11 text-ink']}>
					{counties.map((c) => <option value={c.slug}>{c.fullName}</option>)}
				</select>
			</label>

			<label class="mt-6 flex cursor-pointer items-center justify-between gap-4">
				<span>
					<span class="block text-base font-bold">公開我的相簿</span>
					<span class="mt-1 block text-xs text-muted">其他旅人可以在郵筒頁看到你的打卡照</span>
				</span>
				<input name="publicAlbum" type="checkbox" class="peer sr-only" />
				<span class="relative h-[26px] w-11 shrink-0 rounded-full bg-line transition-colors peer-checked:bg-butter peer-focus-visible:outline-2 peer-focus-visible:outline-pink after:absolute after:top-[3px] after:left-[3px] after:size-5 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-[18px]" aria-hidden="true"></span>
			</label>
		</form>

		<p class="mt-20 text-center"><button id="logout" type="button" class="text-base font-bold text-muted">登出</button></p>
	</Panel>
</Layout>

<script>
	import { getAvatar, getProfile, logout, requireLogin, saveAvatar, saveProfile } from '../../lib/store';

	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	const form = document.getElementById('edit') as HTMLFormElement;
	const avatarEl = document.getElementById('avatar')!;
	const avatarFile = document.getElementById('avatar-file') as HTMLInputElement;
	const showAvatar = (blob: Blob) =>
		avatarEl.replaceChildren(Object.assign(new Image(), { src: URL.createObjectURL(blob), alt: '', className: 'size-full object-cover' }));

	if (requireLogin()) {
		const p = getProfile();
		(form.elements.namedItem('nickname') as HTMLInputElement).value = p.nickname;
		(form.elements.namedItem('bio') as HTMLTextAreaElement).value = p.bio;
		(form.elements.namedItem('county') as HTMLSelectElement).value = p.county;
		(form.elements.namedItem('publicAlbum') as HTMLInputElement).checked = p.publicAlbum;
		avatarEl.textContent = p.nickname.slice(0, 1);
		const avatar = await getAvatar();
		if (avatar) showAvatar(avatar);
	}

	// 「4/12」這類字數
	const counters = () =>
		form.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
			const input = form.elements.namedItem(el.dataset.count!) as HTMLInputElement;
			el.textContent = `${input.value.length}/${input.maxLength}`;
		});
	form.addEventListener('input', counters);
	counters();

	avatarFile.addEventListener('change', () => avatarFile.files?.[0] && showAvatar(avatarFile.files[0]));

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const nickname = String(data.get('nickname')).trim();
		if (!nickname) return (form.elements.namedItem('nickname') as HTMLInputElement).focus();
		saveProfile({ nickname, bio: String(data.get('bio')), county: String(data.get('county')), publicAlbum: data.get('publicAlbum') === 'on' });
		if (avatarFile.files?.[0]) await saveAvatar(avatarFile.files[0]);
		location.replace(`${base}/profile/`);
	});

	document.getElementById('logout')!.addEventListener('click', () => {
		logout();
		location.href = `${base}/`;
	});
</script>
