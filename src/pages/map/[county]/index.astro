---
// Figma：台北（＋過場狀態「台北 #2」）、新北…臺東。有郵筒資料的縣市顯示卡片，其他顯示「即將開放」
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Panel from '../../../components/Panel.astro';
import TaiwanMap from '../../../components/TaiwanMap.astro';
import { counties, mailboxes } from '../../../data/mailboxes';
import mapTitle from '../../../assets/map-title.png';

export const getStaticPaths = () => counties.map((c) => ({ params: { county: c.slug }, props: { county: c } }));

const { county } = Astro.props;
const list = mailboxes.filter((m) => m.county === county.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={county.name}>
	<Panel>
		<h1 class="absolute top-[18px] left-[17px]">
			<Image src={mapTitle} alt="臺灣特色郵筒地圖" width={187} height={20} loading="eager" />
			<span class="sr-only">：{county.name}</span>
		</h1>
		<TaiwanMap selected={county.slug} />

		<div class="slide-up absolute inset-x-3.5 bottom-4 flex flex-col gap-3">
			{
				list.map((m) => (
					<article class="relative flex h-[196px] gap-2 rounded-2xl border-[1.5px] border-pink bg-pink-soft p-3 pl-2.5">
						<Image src={m.illustration} alt={`${m.name}插畫`} width={129} height={133} class="mt-[23px] shrink-0 self-start" />
						<div class="flex flex-col pt-1">
							<h2 class="text-2xl font-bold text-pink">{m.name}</h2>
							<p class="mt-1 text-xs font-bold text-pine">{m.area}</p>
							<p class="mt-2.5 text-sm whitespace-pre-line text-body">{m.summary}</p>
							<a href={`${base}/map/${county.slug}/${m.id}/`} class="mt-auto mb-1 text-md font-bold text-pink">
								看更多 →<span class="sr-only">：{m.name}</span>
							</a>
						</div>
					</article>
				))
			}
			{
				list.length === 0 && (
					<article class="rounded-2xl border-[1.5px] border-pink bg-pink-soft p-4">
						<h2 class="text-2xl font-bold text-pink">{county.name}・即將開放</h2>
						<p class="mt-2 text-sm text-body">這裡的特色郵筒還在整理中，敬請期待！</p>
						<a href={`${base}/map/`} class="mt-3 inline-block text-md font-bold text-pink">← 回到地圖</a>
					</article>
				)
			}
		</div>
	</Panel>
</Layout>

<style>
	.slide-up {
		animation: slide-up 0.5s 0.3s ease both;
	}
	@keyframes slide-up {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.slide-up {
			animation: none;
		}
	}
</style>
