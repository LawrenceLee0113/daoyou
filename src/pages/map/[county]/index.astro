---
// Figma：台北、台中 #2（有卡片的台中）。設計稿另有只有地圖的「台中」等 frame，是點進來時的過場，網頁不做。
// 卡片照設計稿：有詳細頁的郵筒（mailboxes）＋還沒有詳細頁的（upcoming，看更多換成「即將開放」）。
// 卡片一整排左右滑（原型 Frame 12 HORIZONTAL_SCROLLING），平板以上加左右箭頭給滑鼠用。
// 卡片固定 600px 高，內容比較長的（直式照片）在卡片裡上下捲（原型 Frame 15～17 VERTICAL_SCROLLING）。
// 沒有郵筒資料的縣市顯示「即將開放」
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { counties, mailboxes, upcoming } from '../../../data/mailboxes';

export const getStaticPaths = () => counties.map((c) => ({ params: { county: c.slug }, props: { county: c } }));

const { county } = Astro.props;
const hasPage = new Set(mailboxes.map((m) => m.id));
const list = [...mailboxes, ...upcoming].filter((m) => m.county === county.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const card = 'relative flex w-[350px] max-w-[calc(100vw-38px)] shrink-0 snap-center flex-col items-center rounded-mailbox border-[1.5px] border-sage px-[15px] pt-3.5 text-center';
---

<Layout title={county.name}>
	<main class="flex-1 pb-8">
		<div class="relative mx-auto mt-[29px] h-6 max-w-[393px]">
			<a href={`${base}/map/`} class="absolute top-1 left-[27px] text-md font-bold text-olive">← 返回</a>
			<!-- 設計稿用 Nightgazer 字型，找不到下載來源，先用系統粗體（已記入待辦） -->
			<h1 class="mx-auto w-fit text-5xl font-bold tracking-wider text-sage" style="view-transition-name:county-title">{county.fullName}</h1>
		</div>

		<div class="relative mx-auto max-w-6xl">
		<div id="cards" class="mt-2 flex snap-x snap-mandatory justify-center-safe gap-[11px] overflow-x-auto scroll-smooth px-[19px] pt-[11px] [scrollbar-width:none] md:px-16">
			{
				list.map((m, i) => (
					<article class:list={[card, 'rise h-[600px] overflow-y-auto overscroll-y-contain [scrollbar-width:none]']} style={`--i:${i}`}>
						{/* 橫式照片 320×240、直式 320×427，照原圖比例 */}
						<Image src={m.cardPhoto} alt={m.name} widths={[320, 640, 960]} sizes="320px" class="h-auto w-full shrink-0 rounded-photo" loading={i < 2 ? 'eager' : 'lazy'} />
						<h2 class="mt-[29px] text-2xl font-bold text-olive">{m.name}</h2>
						<p class="mt-1.5 text-xs font-bold text-sage">{m.area}</p>
						{/* 有手動換行的照設計稿斷行（較長的行允許超出卡片內距一點）；沒換行的限寬自動折行 */}
						<p class:list={['mt-2.5 text-sm whitespace-pre-line text-body', m.summary.includes('\n') ? '-mx-2' : 'max-w-[200px]']}>{m.summary}</p>
						{/* 短的卡片把插圖推到底部，長的至少留 24px */}
						<div class="min-h-6 flex-1 shrink-0"></div>
						<Image src={m.illustration} alt="" height={102} densities={[1, 2, 3]} class="h-[102px] w-auto shrink-0" />
						{
							hasPage.has(m.id) ? (
								<a href={`${base}/map/${county.slug}/${m.id}/`} class="mt-4 mb-6 text-md font-bold text-pink after:absolute after:inset-0 after:rounded-mailbox">
									看更多 →<span class="sr-only">：{m.name}</span>
								</a>
							) : (
								<p class="mt-4 mb-6 shrink-0 text-md font-bold text-faint">詳細介紹即將開放</p>
							)
						}
					</article>
				))
			}
			{
				list.length === 0 && (
					<article class:list={[card, 'rise h-[240px] justify-center pt-0']}>
						<h2 class="text-2xl font-bold text-olive">即將開放</h2>
						<p class="mt-2.5 text-sm text-body">這裡的特色郵筒還在整理中，敬請期待！</p>
						<a href={`${base}/map/`} class="mt-4 text-md font-bold text-pink">← 回到地圖</a>
					</article>
				)
			}
		</div>
		{
			list.length > 1 &&
				[-1, 1].map((dir) => (
					<button
						type="button"
						data-dir={dir}
						class:list={['absolute top-1/2 hidden size-11 -translate-y-1/2 place-items-center rounded-full border-[1.5px] border-sage bg-white text-xl font-bold text-olive shadow-soft disabled:opacity-0 md:grid', dir < 0 ? 'left-2' : 'right-2']}
						aria-label={dir < 0 ? '上一張' : '下一張'}
						aria-controls="cards"
					>
						{dir < 0 ? '←' : '→'}
					</button>
				))
		}
		</div>
	</main>
</Layout>

<script>
	// 平板以上的左右箭頭：一次捲一張卡片，捲到頭的那一邊隱藏
	const cards = document.getElementById('cards')!;
	const buttons = document.querySelectorAll<HTMLButtonElement>('[aria-controls="cards"]');
	const step = () => (cards.firstElementChild as HTMLElement).offsetWidth + parseFloat(getComputedStyle(cards).columnGap);
	const sync = () =>
		buttons.forEach((b) => (b.disabled = b.dataset.dir === '-1' ? cards.scrollLeft <= 1 : cards.scrollLeft + cards.clientWidth >= cards.scrollWidth - 1));
	buttons.forEach((b) => b.addEventListener('click', () => cards.scrollBy({ left: Number(b.dataset.dir) * step() })));
	cards.addEventListener('scroll', sync, { passive: true });
	addEventListener('resize', sync);
	sync();
</script>
