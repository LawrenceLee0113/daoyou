---
// Figma：台北-歪腰郵筒、台中-新社郵筒（上傳前）、…（已上傳）、…-預覽。
// 「歪腰郵筒-相機」不做：拍照直接叫出手機內建相機（也可從相簿選），拍完在這頁跳出預覽。
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Panel from '../../../components/Panel.astro';
import { mailboxes, countyOf, isLocked } from '../../../data/mailboxes';

export const getStaticPaths = () => mailboxes.map((m) => ({ params: { county: m.county, mailbox: m.id }, props: { mailbox: m } }));

const { mailbox: m } = Astro.props;
const county = countyOf(m.county);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 未開放縣市的郵筒：沒有完整權限就轉回縣市頁（顯示即將開放）
const locked = isLocked(county.slug) ? `${base}/map/${county.slug}/` : undefined;
// 電腦版照片放大成整欄寬
const slide = 'h-[190px] w-[320px] max-w-full shrink-0 snap-start rounded-2xl object-cover lg:aspect-[32/19] lg:h-auto lg:w-full';
---

<Layout title={`${county.name}・${m.name}`} locked={locked}>
	<Panel class="pt-[34px] pb-6 lg:max-w-none">
		<a href={`${base}/map/${county.slug}/`} class="text-md font-bold text-olive">← 返回{county.name}</a>

		<!-- 電腦版：左邊照片、右邊介紹 -->
		<div class="lg:mt-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-12">
			<div class="mt-5 ml-[9px] lg:mt-0 lg:ml-0">
				<div id="carousel" data-mailbox={m.id} data-slide={slide} class="-mr-[13px] flex snap-x snap-mandatory gap-2.5 overflow-x-auto pr-[13px] [scrollbar-width:none] lg:mr-0 lg:pr-0">
					<Image src={m.photo} alt={m.name} widths={[320, 640]} sizes="(min-width: 1024px) 500px, 320px" class={slide} loading="eager" />
				</div>
			</div>

			<div>
				<h1 class="mt-7 text-4xl font-bold text-pink lg:mt-0">{m.name}</h1>
				<p class="mt-1.5 text-md font-bold text-olive">{m.address}</p>
				{
					m.sections.map((s, i) => (
						<section class={i === 0 ? 'mt-[18px]' : 'mt-[23px]'}>
							<h2 class="text-lg font-bold">{s.title}</h2>
							<p class="mt-1.5 text-base whitespace-pre-line text-body">{s.body}</p>
						</section>
					))
				}

				<section class="mt-[21px]">
					<h2 class="text-lg font-bold">旅人打卡照</h2>
					<div class="mt-2.5 flex items-center gap-3">
						<button
							id="shoot"
							type="button"
							class="h-10 w-[140px] shrink-0 rounded-full bg-butter text-lg font-bold text-pink disabled:opacity-50"
						>
							📷 拍照打卡
						</button>
						<input id="file" type="file" accept="image/*" capture="environment" hidden />
						<p id="first" class="text-sm text-muted">成為第一位打卡的旅人！</p>
						<div id="mine" hidden class="flex items-center gap-2">
							<img id="mine-img" alt="你的打卡照" class="size-10 rounded-lg object-cover" />
							<div>
								<p class="text-sm font-bold">你的打卡照</p>
								<p id="mine-time" class="text-xs text-muted"></p>
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</Panel>

	<dialog
		id="preview"
		tabindex="-1"
		class="m-0 h-dvh flex-col overflow-hidden overscroll-none outline-none open:flex max-h-none w-full max-w-none bg-black text-white backdrop:bg-black md:m-auto md:h-auto md:overflow-auto md:max-h-[95dvh] md:max-w-md md:rounded-3xl md:pb-8 md:backdrop:bg-black/70"
		aria-labelledby="preview-title"
	>
		<!-- 手機不能上下滑（使用者要求）：照片吃剩下的高度，矮的手機照片縮小，整個畫面剛好一頁 -->
		<div class="relative flex h-[100px] shrink-0 items-start justify-center pt-14">
			<button id="close" type="button" class="absolute top-[52px] left-6 text-3xl leading-none font-bold" aria-label="關閉">✕</button>
			<h2 id="preview-title" class="text-lg font-bold">預覽</h2>
		</div>
		<img id="preview-img" alt="剛拍的照片" class="max-h-[524px] min-h-0 w-full flex-1 object-contain md:h-[min(524px,55dvh)] md:flex-none" />
		<label class="mt-6 flex shrink-0 items-center gap-2.5 px-10 text-base">
			<!-- v5：奶油黃方框＋粉紅勾（原生 checkbox 的勾勾顏色改不了，自己畫） -->
			<input id="save" type="checkbox" checked class="grid size-5 shrink-0 appearance-none place-items-center rounded bg-butter text-[13px] font-bold text-pink checked:after:content-['✓'] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" />
			同時儲存到手機相簿
		</label>
		<div class="mt-8 flex shrink-0 gap-4 px-10">
			<button id="retake" type="button" class="h-12 w-[140px] rounded-full border border-white text-lg font-bold">重拍</button>
			<button id="upload" type="button" class="h-12 flex-1 rounded-full bg-butter text-lg font-bold text-pink disabled:opacity-50">上傳到此頁</button>
		</div>
		<p class="mt-5 mb-[max(20px,env(safe-area-inset-bottom))] shrink-0 text-center text-sm text-muted md:mb-0">照片會自動收進「個人檔案 › 我的相簿」</p>
	</dialog>
	<!-- 上傳後的獎勵：第一次蓋郵票＋島幣，之後只飄島幣 -->
	<div id="reward" hidden class="pointer-events-none fixed inset-0 z-50 grid place-items-center" aria-live="polite">
		<div class="relative grid place-items-center">
			<div id="reward-stamp" class="grid size-36 place-items-center rounded-full border-4 border-double border-pink bg-white/95 p-3 text-center text-pink shadow-soft">
				<span class="text-xs font-bold">{county.fullName}</span>
				<span class="text-xl leading-tight font-bold">{m.name}</span>
				<span class="text-2xs font-bold tracking-widest">郵票 GET!</span>
			</div>
			<p id="reward-coins" class="absolute -bottom-12 rounded-full bg-butter px-5 py-1.5 text-2xl font-bold whitespace-nowrap text-pink shadow-soft"></p>
		</div>
	</div>
</Layout>

<script>
	import { addPhoto, getPhotos, requireLogin } from '../../../lib/store';
	import { toast } from '../../../lib/toast';
	import { MAX_PHOTOS_PER_MAILBOX as max, COINS_FIRST_PHOTO, COINS_EXTRA_PHOTO } from '../../../lib/rules';

	// 動畫跑完再藏起來：先移掉 class 重新觸發動畫
	function play(el: HTMLElement, cls: string) {
		el.classList.remove(cls);
		void el.offsetWidth;
		el.classList.add(cls);
	}

	function showReward(first: boolean) {
		const box = $('reward'), stamp = $('reward-stamp'), coins = $('reward-coins');
		box.classList.remove('fade-out');
		box.hidden = false;
		stamp.hidden = !first;
		coins.textContent = `+${first ? COINS_FIRST_PHOTO : COINS_EXTRA_PHOTO} 島幣`;
		if (first) play(stamp, 'stamp-in');
		play(coins, 'coins-up');
		setTimeout(() => play(box, 'fade-out'), 1800);
		setTimeout(() => (box.hidden = true), 2100);
	}

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const { mailbox: mailboxId, slide } = $('carousel').dataset as { mailbox: string; slide: string };
	const file = $<HTMLInputElement>('file');
	const dialog = $<HTMLDialogElement>('preview');
	let picked: File | undefined;

	async function render() {
		const photos = await getPhotos(mailboxId);
		const carousel = $('carousel');
		carousel.querySelectorAll('[data-mine]').forEach((el) => el.remove());
		for (const p of photos) {
			const img = Object.assign(document.createElement('img'), { src: URL.createObjectURL(p.blob), alt: '你的打卡照', className: slide });
			img.dataset.mine = '';
			carousel.append(img);
		}
		carousel.scrollLeft = 0;
		$('first').hidden = photos.length > 0;
		$('mine').hidden = photos.length === 0;
		$<HTMLButtonElement>('shoot').disabled = photos.length >= max;
		if (!photos.length) return;
		$<HTMLImageElement>('mine-img').src = (carousel.querySelector('[data-mine]') as HTMLImageElement).src;
		const t = new Date(photos[0].createdAt);
		const when = Date.now() - photos[0].createdAt < 60_000 ? '剛剛' : `${t.getMonth() + 1}/${t.getDate()}`;
		$('mine-time').textContent = photos.length >= max ? `已達每個郵筒 ${max} 張上限` : `${when}・已收進相簿`;
	}

	// 「同時儲存到手機相簿」：手機用分享選單（iOS 可選「儲存影像」），不支援的話直接下載
	function saveToDevice(f: File) {
		const named = new File([f], `daoyou-${Date.now()}.jpg`, { type: f.type });
		if (navigator.canShare?.({ files: [named] })) return navigator.share({ files: [named] }).catch(() => {});
		const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(named), download: named.name });
		a.click();
	}

	$('shoot').addEventListener('click', () => requireLogin() && file.click());
	$('retake').addEventListener('click', () => file.click());
	$('close').addEventListener('click', () => dialog.close());
	file.addEventListener('change', () => {
		picked = file.files?.[0];
		file.value = ''; // 同一張再選一次也要觸發 change
		if (!picked) return;
		$<HTMLImageElement>('preview-img').src = URL.createObjectURL(picked);
		// 焦點放在對話框本身，不然瀏覽器會自動跳到 ✕ 上畫藍框
		if (!dialog.open) dialog.showModal(), dialog.focus();
	});
	$('upload').addEventListener('click', async () => {
		if (!picked) return;
		const btn = $<HTMLButtonElement>('upload');
		btn.disabled = true;
		if ($<HTMLInputElement>('save').checked) saveToDevice(picked); // 要在使用者點擊的當下呼叫
		try {
			const first = (await getPhotos(mailboxId)).length === 0;
			await addPhoto(mailboxId, picked);
			dialog.close();
			await render();
			// Figma 畫在照片上方；使用者要求改到畫面最下方，按完拍照打卡捲在下面也看得到
			toast('✓ 已上傳！也收進了你的相簿　查看 →', { href: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/profile/`, ms: 6000 });
			showReward(first);
		} catch (e) {
			toast(e instanceof Error ? e.message : '上傳失敗，請再試一次', { error: true, ms: 6000 });
		} finally {
			btn.disabled = false;
		}
	});

	render();
</script>
