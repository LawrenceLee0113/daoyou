---
// Figma：特色郵筒
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TaiwanMap from '../../components/TaiwanMap.astro';
import mapTitle from '../../assets/map-title.png';
---

<Layout title="特色郵筒">
	<main class="h-[705px] overflow-hidden">
		<!-- 地圖跟標籤照設計稿 393px 寬的座標排，螢幕比較寬時整塊置中 -->
		<div id="map-stage" class="relative mx-auto h-full w-[393px]">
			<h1 class="absolute top-8 left-[27px]"><Image src={mapTitle} alt="臺灣特色郵筒地圖" width={187} height={20} densities={[1, 2]} loading="eager" /></h1>
			<TaiwanMap />
		</div>
	</main>
</Layout>

<script is:inline>
	// 比 393px 窄的手機（例如 iPhone SE 375px）整塊等比縮小，標籤才不會被切掉
	const stage = document.getElementById('map-stage');
	const fit = () => (stage.style.zoom = String(Math.min(1, innerWidth / 393)));
	fit();
	addEventListener('resize', fit);
</script>

<script>
	// 隱藏開關（使用者 2026-11-04）：沒登入或用舊密碼時，7 秒內點頁首綠色花紋 10 次就顯示全部縣市，再點一次切回部分。
	// 用 apple1119 登入的本來就看得到全部，不受影響。狀態存在這支手機上，換頁後還在
	import { hasFullPassword, isUnlocked, setUnlocked } from '../../lib/store';
	const TAPS = 10;
	const WINDOW_MS = 7000;
	let taps: number[] = [];
	const apply = () => document.documentElement.toggleAttribute('data-full', hasFullPassword() || isUnlocked());
	document.getElementById('header-band')!.addEventListener('click', () => {
		if (hasFullPassword()) return;
		if (isUnlocked()) {
			setUnlocked(false);
			taps = [];
			return apply();
		}
		const now = Date.now();
		taps = [...taps.filter((t) => now - t < WINDOW_MS), now];
		if (taps.length < TAPS) return;
		taps = [];
		setUnlocked(true);
		apply();
	});
</script>
