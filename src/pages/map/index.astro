---
// Figma：特色郵筒
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TaiwanMap from '../../components/TaiwanMap.astro';
import mapTitle from '../../assets/map-title.png';
---

<Layout title="特色郵筒">
	<main class="h-[705px] overflow-hidden">
		<!-- 地圖跟標籤照設計稿 393px 寬的座標排，螢幕比較寬時整塊置中 -->
		<div id="map-stage" class="relative mx-auto h-full w-[393px]">
			<h1 class="absolute top-8 left-[27px]"><Image src={mapTitle} alt="臺灣特色郵筒地圖" width={187} height={20} loading="eager" /></h1>
			<p class="absolute top-[60px] left-[27px] flex items-center gap-1 text-2xs text-muted" aria-hidden="true"><span class="size-2 rounded-full bg-pink"></span>有特色郵筒</p>
			<TaiwanMap />
		</div>
	</main>
</Layout>

<script is:inline>
	// 比 393px 窄的手機（例如 iPhone SE 375px）整塊等比縮小，標籤才不會被切掉
	const stage = document.getElementById('map-stage');
	const fit = () => (stage.style.zoom = String(Math.min(1, innerWidth / 393)));
	fit();
	addEventListener('resize', fit);
</script>
