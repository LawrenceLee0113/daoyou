---
// Figma：登入。只有一組示範帳號（在 src/lib/store.ts），第三方登入、註冊都還沒有
import Layout from '../layouts/Layout.astro';

const field = 'mt-1.5 block h-[50px] rounded-[20px] border-2 border-black bg-white px-4 text-md outline-none placeholder:text-input focus:border-pink';
---

<Layout guest title="登入">
	<main class="flex flex-1 flex-col px-[42px] pt-[125px] pb-16 md:justify-center md:py-16">
		<h1 class="sr-only">登入島郵</h1>
		<form id="login" class="mx-auto flex w-full max-w-[309px] flex-col tracking-[0.1em]" novalidate>
			<label class="text-lg">
				帳號
				<input name="email" type="email" autocomplete="username" placeholder="repost116.grad@gmail.com" class:list={[field, 'ml-[5px] w-[304px] max-w-[calc(100%-5px)] tracking-normal']} />
			</label>
			<label class="mt-[42px] text-lg">
				密碼
				<input name="password" type="password" autocomplete="current-password" placeholder="••••••••" class:list={[field, 'ml-[5px] w-[304px] max-w-[calc(100%-5px)] tracking-[0.3em]']} />
			</label>
			<p id="error" class="mt-3 ml-[5px] min-h-5 text-sm text-pink" aria-live="polite"></p>
			<button class="mt-2 ml-[5px] h-[50px] w-[304px] max-w-[calc(100%-5px)] rounded-[20px] bg-input text-lg tracking-[0.2em] shadow-soft">登入</button>
		</form>

		<div class="mt-auto flex flex-col items-center md:mt-16">
			<!-- 品牌圖示用 SVG 畫（設計稿匯出的 PNG 連陰影一起被裁到、又太糊） -->
			<div class="flex gap-[26px]">
				<button type="button" class="social grid size-[55px] place-items-center rounded-full bg-white shadow-soft" aria-label="使用 Google 登入">
					<svg width="30" height="30" viewBox="0 0 48 48" aria-hidden="true">
						<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
						<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
						<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
						<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
					</svg>
				</button>
				<button type="button" class="social grid size-[55px] place-items-center rounded-full bg-facebook text-white shadow-soft" aria-label="使用 Facebook 登入">
					<svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2C11.54 2 9.68 3.66 9.68 6.7v2.62H6.61v3.56h3.07V22h3.68v-9.12h3.06l.46-3.56h-3.52V7.05c0-1.03.28-1.73 1.76-1.73z" />
					</svg>
				</button>
				<button type="button" class="social grid size-[55px] place-items-center rounded-full bg-apple text-white shadow-soft" aria-label="使用 Apple 登入">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
					</svg>
				</button>
			</div>
			<p class="mt-5 text-lg tracking-[0.1em]">還不是會員? <span class="text-signup">趕快加入島郵吧!</span></p>
		</div>
	</main>
</Layout>

<script>
	import { login } from '../lib/store';

	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	const error = document.getElementById('error')!;
	document.getElementById('login')!.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = new FormData(e.target as HTMLFormElement);
		if (!login(String(data.get('email')), String(data.get('password')))) {
			error.textContent = '帳號或密碼錯誤';
			return;
		}
		// 只接受站內路徑，避免被帶到別的網站：比對解析後的 origin（「/\evil.com」這類寫法字串檢查擋不住）
		const next = new URL(new URLSearchParams(location.search).get('next') ?? `${base}/profile/`, location.href);
		location.href = next.origin === location.origin ? next.href : `${base}/profile/`;
	});
	document.querySelectorAll('.social').forEach((b) =>
		b.addEventListener('click', () => (error.textContent = '目前只開放示範帳號登入')),
	);
</script>
