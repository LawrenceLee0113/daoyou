---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import headerTop from '../assets/header-top.png';
import { DEMO_EMAIL, LOGIN_KEY } from '../lib/store';

interface Props {
	title?: string;
	description?: string;
	// 相機、預覽這類全螢幕畫面不要頁首
	header?: boolean;
	// 需要登入的頁面：沒登入在畫面出來前就導去登入頁；有登入先藏內容，頁面用 store.whenReady 填好資料才顯示
	auth?: boolean;
	// 只給沒登入的人看的頁面（登入頁）：已登入在畫面出來前就轉到 ?next= 指的站內頁，沒有就到個人檔案
	guest?: boolean;
}

const { title, description = '寄存島嶼的地方郵誌', header = true, auth = false, guest = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 手機瀏海裡的花紋（同頁首花紋）
const notchBand = await getImage({ src: headerTop, width: 786 });
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title ? `${title}｜島郵 Isle Post` : '島郵 Isle Post'}</title>
		{
			guest && (
				<script is:inline define:vars={{ key: LOGIN_KEY, email: DEMO_EMAIL, base }}>
					let ok = false;
					try {
						ok = localStorage.getItem(key) === email;
					} catch {}
					if (ok) {
						// 只接受站內路徑，避免被帶到別的網站（同 login.astro）
						const next = new URL(new URLSearchParams(location.search).get('next') ?? `${base}/profile/`, location.href);
						location.replace(next.origin === location.origin ? next.href : `${base}/profile/`);
					}
				</script>
			)
		}
		{
			auth && (
				<script is:inline define:vars={{ key: LOGIN_KEY, email: DEMO_EMAIL, login: `${base}/login/` }}>
					// 同步執行、還沒畫第一格就決定：比 module script 早，才不會先閃一下。規則同 store.isLoggedIn
					let ok = false;
					try {
						ok = localStorage.getItem(key) === email;
					} catch {}
					if (!ok) location.replace(`${login}?next=${encodeURIComponent(location.pathname + location.search)}`);
					else {
						document.documentElement.dataset.pending = '';
						// ponytail: 保險，script 載入失敗也不會一直空白
						setTimeout(() => delete document.documentElement.dataset.pending, 3000);
					}
				</script>
				<style is:global>
					/* 只藏 Panel 裡的內容，底色和頁首照常出現 */
					html[data-pending] main > * > * {
						visibility: hidden;
					}
				</style>
			)
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- 字型樣式表不擋住第一次繪製（media=print 先不套用，載完再切成 all），換頁才不會卡在等字型 -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC&family=Chiron+Hei+HK:wght@500&family=Chiron+Sung+HK:wght@700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
	</head>
	<body class="bg-white font-sans text-ink antialiased">
		<!-- 設計稿是手機版；平板、電腦版由各頁用 md:／lg: 調整（內容最寬 max-w-6xl） -->
		<!-- 手機、平板的瀏海：iOS Safari 不畫「頁面頂端以外」，也不畫固定在畫面上的東西，只畫捲到畫面上方的一般內容。
		     所以頁面最上面放 100px 花紋，載入時頁面本身捲下 100px 把它藏進瀏海後面、之後鎖在這個位置（下面的 script）。
		     花紋位置對齊頁首露出的那 28px（頁首花紋 87px 的最下面 28px） -->
		{
			header && (
				<div
					id="notch-fill"
					class="h-[100px] lg:hidden"
					style={`background: url(${notchBand.src}) center calc(100% + 28px) / 100% auto repeat-y`}
					aria-hidden="true"
				/>
			)
		}
		<!-- 手機、平板：整頁剛好一個螢幕高、本身不捲，由頁首下面的 #scroller 捲動，頁首和瀏海的花紋才會完全不動（見 SiteHeader）。
		     代價：Safari 網址列不會隨捲動縮小、點時鐘不會回頂端、上一頁回來不記得捲到哪。電腦版照常由頁面捲動 -->
		<div class="flex h-dvh w-full flex-col lg:h-auto lg:min-h-dvh">
			{
				header && (
					<script is:inline>
						// 頁面本身鎖在剛好藏住 #notch-fill 的位置（鍵盤跳出等情況被系統捲動時拉回來）。
						// 每次都重新判斷寬度：iPad 轉橫向變成電腦版時要放開，不然頁面捲不動
						const mobile = matchMedia('(width < 64rem)');
						const pin = () => mobile.matches && scrollY !== 100 && scrollTo(0, 100);
						pin();
						addEventListener('scroll', pin, { passive: true });
						addEventListener('resize', pin);
					</script>
				)
			}
			{header && <SiteHeader />}
			<div id="scroller" class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-y-contain lg:overflow-visible">
				<slot />
			</div>
		</div>
	</body>
</html>
