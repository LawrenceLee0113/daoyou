---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { DEMO_EMAIL, FULL_KEY, LOGIN_KEY } from '../lib/store';

interface Props {
	title?: string;
	description?: string;
	// 相機、預覽這類全螢幕畫面不要頁首
	header?: boolean;
	// 需要登入的頁面：沒登入在畫面出來前就導去登入頁；有登入先藏內容，頁面用 store.whenReady 填好資料才顯示
	auth?: boolean;
	// 只給沒登入的人看的頁面（登入頁）：已登入在畫面出來前就轉到 ?next= 指的站內頁，沒有就到個人檔案
	guest?: boolean;
	// 只有完整權限（FULL_PASSWORD 登入）看得到的頁面：沒有權限在畫面出來前就轉到這個網址
	locked?: string;
}

const { title, description = '寄存島嶼的地方郵誌', header = true, auth = false, guest = false, locked } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- iOS 點到字小於 16px 的輸入框會自動放大（使用者 2026-11-03 要求維持原比例）。只對 iOS 加 maximum-scale=1：
		     iOS 照樣可以用兩指放大（系統忽略這個限制），只是不會自動放大；Android 不加，才不會擋住兩指放大 -->
		<script is:inline>
			if (/iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1))
				document.querySelector('meta[name=viewport]').content += ', maximum-scale=1';
		</script>
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title ? `${title}｜島郵 Isle Post` : '島郵 Isle Post'}</title>
		<!-- 完整權限（用 FULL_PASSWORD 登入）：<html data-full>，未開放縣市的內容才會顯示（見 data/mailboxes.ts openCounties）。規則同 store.login -->
		<script is:inline define:vars={{ key: LOGIN_KEY, fullKey: FULL_KEY, email: DEMO_EMAIL, locked }}>
			let full = false;
			try {
				full = localStorage.getItem(key) === email && !!localStorage.getItem(fullKey);
			} catch {}
			if (full) document.documentElement.dataset.full = '';
			else if (locked) location.replace(locked);
		</script>
		{
			guest && (
				<script is:inline define:vars={{ key: LOGIN_KEY, email: DEMO_EMAIL, base }}>
					let ok = false;
					try {
						ok = localStorage.getItem(key) === email;
					} catch {}
					if (ok) {
						// 只接受站內路徑，避免被帶到別的網站（同 login.astro）
						const next = new URL(new URLSearchParams(location.search).get('next') ?? `${base}/profile/`, location.href);
						location.replace(next.origin === location.origin ? next.href : `${base}/profile/`);
					}
				</script>
			)
		}
		{
			auth && (
				<script is:inline define:vars={{ key: LOGIN_KEY, email: DEMO_EMAIL, login: `${base}/login/` }}>
					// 同步執行、還沒畫第一格就決定：比 module script 早，才不會先閃一下。規則同 store.isLoggedIn
					let ok = false;
					try {
						ok = localStorage.getItem(key) === email;
					} catch {}
					if (!ok) location.replace(`${login}?next=${encodeURIComponent(location.pathname + location.search)}`);
					else {
						document.documentElement.dataset.pending = '';
						// ponytail: 保險，script 載入失敗也不會一直空白
						setTimeout(() => delete document.documentElement.dataset.pending, 3000);
					}
				</script>
				<style is:global>
					/* 只藏 Panel 裡的內容，底色和頁首照常出現 */
					html[data-pending] main > * > * {
						visibility: hidden;
					}
				</style>
			)
		}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- 字型樣式表不擋住第一次繪製（media=print 先不套用，載完再切成 all），換頁才不會卡在等字型 -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC&family=Chiron+Hei+HK:wght@500&family=Chiron+Sung+HK:wght@700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
	</head>
	<body class="bg-white font-sans text-ink antialiased">
		<!-- 設計稿是手機版；平板、電腦版由各頁用 md:／lg: 調整（內容最寬 max-w-6xl） -->
		<div class="flex min-h-dvh w-full flex-col">
			{header && <SiteHeader />}
			<slot />
		</div>
	</body>
</html>
